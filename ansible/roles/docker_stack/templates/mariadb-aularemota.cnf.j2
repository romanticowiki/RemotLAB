# Gestionado por Ansible (rol docker_stack).
# Ajustado para la base pequena de Guacamole en una instancia de 1 GiB.
[mysqld]
performance_schema = OFF
innodb_buffer_pool_size = 64M
# MariaDB 10.5.29 ignora innodb_buffer_pool_instances desde 10.5.1. Omitirlo
# evita dejar una directiva obsoleta que parece activa pero no hace nada.
key_buffer_size = 8M
tmp_table_size = 16M
max_heap_table_size = 16M
max_connections = 30
