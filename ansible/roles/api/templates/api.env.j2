# Gestionado por Ansible (rol api). Permisos 0600.
# El token NO va dentro de la unit de systemd: "systemctl cat" la deja leer a
# cualquier usuario del sistema.
AR_API_HOST={{ api_host }}
AR_API_PORT={{ api_puerto }}
AR_API_TOKEN={{ api_token }}
AR_LIMITE_SESIONES={{ usuarios_lab | length }}
AR_MYSQL_DATABASE={{ mysql_database }}
AR_GUAC_INTERNA={{ guac_url_interna }}
AR_GUAC_PUERTO_PUBLICO={{ guac_puerto_publico }}
AR_GUAC_URL_PUBLICA={{ 'https://' ~ lab_fqdn ~ '/guacamole' if proxy_activo == 'caddy' else '' }}
AR_GUAC_USUARIO={{ guac_usuario_app }}
AR_GUAC_PASSWORD={{ guac_supervisor_password }}
AR_PROXY_CONTENEDOR={{ 'caddy' if proxy_activo == 'caddy' else 'nginx_proxy' }}
