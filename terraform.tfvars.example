# Copia este archivo como terraform.tfvars y sustituye los valores de ejemplo.
# terraform.tfvars esta ignorado para evitar publicar datos del despliegue.

aws_region        = "us-east-1"
availability_zone = "us-east-1a"

vpc_cidr    = "10.0.77.0/24"
subnet_cidr = "10.0.77.0/26"
private_ip  = "10.0.77.58"

# t3.micro sirve para validar infraestructura, pero no para cuatro escritorios.
instance_type   = "t3.micro"
root_volume_size = 30
ami_id            = null

key_pair_name = "replace-with-your-key-pair"
admin_cidr    = "203.0.113.10/32"
lab_fqdn      = "lab.example.com"

# Activalo solo durante pruebas sin proxy TLS. Para produccion usa HTTPS en 443.
api_expuesta = false
